aws ecr get-login-password | docker login --username AWS --password-stdin %AWS_ACCOUNT%.dkr.ecr.%AWS_REGION%.amazonaws.com
set AWS_ACCOUNT=881490115226
set AWS_REGION=us-east-1
set v=01
set name=spark-arm64

docker tag %name%:%v% %AWS_ACCOUNT%.dkr.ecr.%AWS_REGION%.amazonaws.com/rust-serverless:v%v%-%name%
docker push %AWS_ACCOUNT%.dkr.ecr.%AWS_REGION%.amazonaws.com/rust-serverless:v%v%-%name%

docker build -f DockerfileSparkScala -t "%name%:%v%" --provenance=false ./

curl -X POST "http://localhost:9000/2015-03-31/functions/function/invocations" -H "Content-Type: application/json" --data-binary @event.json

docker run -it -d --platform linux/arm64 -p 9000:8080 --env-file .env --name spark-e ${name}:${v}

docker run -it -d -p 9000:8080 --name spark-rust "%name%:%v%"

export v=22
export name=kinesis-rust-snowflake-arm64
