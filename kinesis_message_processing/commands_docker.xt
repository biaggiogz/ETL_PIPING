export AWS_REGION=us-east-1

docker buildx build --platform linux/arm64 --build-arg package=kinesis-lambda \
  --build-arg TARGETPLATFORM=linux/arm64 \
  -f Dockerfile \
  -t ${name}:${v} .

docker tag ${name}:${v} ${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/rust-stream:v${v}-${name}
docker push ${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/rust-stream:v${v}-${name}

